model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String?
  currency     String    @default("USD") @db.VarChar(3)
  timezone     String    @default("UTC")
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  accounts          Account[]
  attachments       Attachment[]
  budgets           Budget[]
  categories        Category[]
  devices           Device[]
  refreshTokens     RefreshToken[]
  syncStates        SyncState[]
  tags              Tag[]
  transactions      Transaction[]
  schedules         TransactionSchedule[]
  restoreDatasets   RestoreDataset[]
  deletionRequests  DataDeletionRequest[]
  emailChangeTokens EmailChangeToken[]
}

model DataDeletionRequest {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  requestedAt  DateTime  @default(now()) @db.Timestamptz(3)
  scheduledFor DateTime  @db.Timestamptz(3)
  cancelledAt  DateTime? @db.Timestamptz(3)
  completedAt  DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, completedAt])
  @@index([userId, requestedAt])
}

model EmailChangeToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  email     String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
