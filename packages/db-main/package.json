{
  "name": "@expense-tracker/db-main",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/services": {
      "types": "./dist/adapters/services.d.ts",
      "default": "./dist/adapters/services.js"
    }
  },
  "scripts": {
    "dev": "node ../../secrets/run-with-env.mjs ../../secrets/env.development.database -- node node_modules/prisma/build/index.js dev --detach --db-port 51214 --shadow-db-port 51215 && node ../../secrets/run-with-env.mjs ../../secrets/env.development.database -- node node_modules/prisma/build/index.js migrate deploy",
    "generate": "node ../../secrets/run-with-env.mjs ../../secrets/env.development.database -- node node_modules/prisma/build/index.js generate",
    "build": "pnpm run generate && tsc",
    "check-types": "pnpm run generate && tsc --noEmit"
  },
  "dependencies": {
    "@expense-tracker/services": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:"
  }
}
