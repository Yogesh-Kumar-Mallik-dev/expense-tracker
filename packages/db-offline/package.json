{
  "name": "@expense-tracker/db-offline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./driver/web": {
      "types": "./dist/driver/web.d.ts",
      "development": "./src/driver/web.ts",
      "default": "./dist/driver/web.js"
    },
    "./driver/mobile": {
      "types": "./dist/driver/mobile.d.ts",
      "default": "./dist/driver/mobile.js"
    },
    "./driver/desktop": {
      "types": "./dist/driver/desktop.d.ts",
      "development": "./src/driver/desktop.ts",
      "default": "./dist/driver/desktop.js"
    },
    "./adapters/services": {
      "types": "./dist/adapters/services.d.ts",
      "default": "./dist/adapters/services.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "drizzle:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@expense-tracker/services": "workspace:*",
    "@journeyapps/wa-sqlite": "catalog:",
    "@powersync/common": "catalog:",
    "@powersync/drizzle-driver": "catalog:",
    "@powersync/react-native": "catalog:",
    "@powersync/tauri-plugin": "catalog:",
    "@powersync/web": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
