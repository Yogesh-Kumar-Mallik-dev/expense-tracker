DATABASE_URL=postgresql://user:password@localhost:5432/expense_tracker
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-characters
POWERSYNC_URL=https://example.powersync.journeyapps.com
POWERSYNC_PRIVATE_KEY_BASE64=base64-encoded-rsa-private-key-pem
POWERSYNC_KEY_ID=expense-tracker-powersync-1
POWERSYNC_AUDIENCE=https://example.powersync.journeyapps.com
POWERSYNC_ISSUER=https://api.example.com
ATTACHMENT_BUCKET=expense-tracker-attachments
ATTACHMENT_REGION=us-east-1
# Optional for MinIO, Cloudflare R2, and other S3-compatible services:
# ATTACHMENT_ENDPOINT=https://s3-compatible.example.com
ATTACHMENT_FORCE_PATH_STYLE=false
# Optional when the runtime does not provide an IAM role:
# ATTACHMENT_ACCESS_KEY_ID=
# ATTACHMENT_SECRET_ACCESS_KEY=
ATTACHMENT_MAX_BYTES=10485760
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
LOG_STACKS=false
TRUST_PROXY=false
WEB_APP_URL=http://localhost:3000
# Required in production for verified email changes:
# RESEND_API_KEY=re_...
# EMAIL_FROM=Expense Tracker <accounts@example.com>
