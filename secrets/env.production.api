# Replace every required value through the production secret manager.
ACCESS_TOKEN_SECRET=replace-with-production-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-production-refresh-token-secret
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=true
POWERSYNC_URL=https://replace-with-production-powersync.example.com
POWERSYNC_PRIVATE_KEY_BASE64=replace-with-production-base64-private-key
POWERSYNC_KEY_ID=expense-tracker-powersync-1
POWERSYNC_AUDIENCE=https://replace-with-production-powersync.example.com
POWERSYNC_ISSUER=https://api.example.com
ATTACHMENT_BUCKET=replace-with-production-bucket
ATTACHMENT_REGION=replace-with-production-region
ATTACHMENT_FORCE_PATH_STYLE=false
ATTACHMENT_ACCESS_KEY_ID=replace-or-use-runtime-iam-role
ATTACHMENT_SECRET_ACCESS_KEY=replace-or-use-runtime-iam-role
ATTACHMENT_MAX_BYTES=10485760
RESEND_API_KEY=replace-with-production-email-provider-key
EMAIL_FROM=Expense Tracker <accounts@example.com>
WEB_APP_URL=https://app.example.com
RETENTION_JOB_SECRET=replace-with-production-retention-secret
TELEMETRY_INGEST_URL=https://telemetry.example.com/ingest
TELEMETRY_INGEST_TOKEN=replace-with-production-telemetry-token
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
LOG_STACKS=false
