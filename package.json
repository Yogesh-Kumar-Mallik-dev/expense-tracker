{
  "name": "expense-tracker",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@expense-tracker/api",
    "build:web": "turbo run build --filter=@expense-tracker/web",
    "build:desktop": "turbo run build --filter=@expense-tracker/desktop",
    "build:tauri": "pnpm --filter @expense-tracker/desktop tauri:build",
    "build:mobile": "turbo run build --filter=@expense-tracker/mobile",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @expense-tracker/api dev",
    "dev:web": "pnpm --filter @expense-tracker/web dev",
    "dev:desktop": "pnpm --filter @expense-tracker/desktop dev",
    "dev:tauri": "pnpm --filter @expense-tracker/desktop tauri:dev",
    "dev:mobile": "pnpm --filter @expense-tracker/mobile dev",
    "dev:mobile:web": "pnpm --filter @expense-tracker/mobile web",
    "dev:mobile:android": "pnpm --filter @expense-tracker/mobile android",
    "dev:mobile:ios": "pnpm --filter @expense-tracker/mobile ios",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:api": "pnpm --filter @expense-tracker/tests test:api",
    "test:web": "pnpm --filter @expense-tracker/tests test:web",
    "test:desktop": "pnpm --filter @expense-tracker/tests test:web",
    "test:mobile": "pnpm --filter @expense-tracker/tests test:native",
    "test:services": "pnpm --filter @expense-tracker/tests test:services",
    "test:logger": "pnpm --filter @expense-tracker/tests test:logger"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=20.19"
  }
}
